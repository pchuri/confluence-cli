{
  "name": "confluence-cli",
  "version": "2.30.3",
  "description": "A command-line interface for Atlassian Confluence with page creation and editing capabilities",
  "main": "index.js",
  "bin": {
    "confluence": "bin/index.js",
    "confluence-cli": "bin/index.js"
  },
  "scripts": {
    "start": "node bin/confluence.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "pi-package",
    "confluence",
    "atlassian",
    "cli",
    "wiki",
    "documentation"
  ],
  "author": "pchuri",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "entities": "^8.1.0",
    "form-data": "^4.0.6",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "inquirer": "^8.2.6",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "typebox": "^1.3.18"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "skills": [
      "./plugins/confluence/skills"
    ],
    "extensions": [
      "./.pi/extensions/confluence-cli.ts"
    ]
  },
  "overrides": {
    "js-yaml": "$js-yaml",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pchuri/confluence-cli.git"
  },
  "bugs": {
    "url": "https://github.com/pchuri/confluence-cli/issues"
  },
  "homepage": "https://github.com/pchuri/confluence-cli#readme",
  "files": [
    "bin/",
    "lib/",
    "plugins/",
    ".pi/",
    ".claude-plugin/",
    "npm-shrinkwrap.json"
  ]
}
